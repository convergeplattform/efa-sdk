{
  "name": "@efa-one/sdk",
  "version": "1.10.2",
  "description": "Offizielles SDK für efa-one-Apps: Auth/Session, Service-Discovery, Gateway-Client, Audit/Reporting/Mail/Notifications, Permission- und Capability-Registrierung sowie das Frontend-IPC-/i18n-Toolkit.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "exports": {
    "./backend": {
      "types": "./backend/index.d.ts",
      "require": "./backend/index.js",
      "default": "./backend/index.js"
    },
    "./backend/*": {
      "types": "./backend/*.d.ts",
      "require": "./backend/*.js",
      "default": "./backend/*.js"
    },
    "./frontend": {
      "types": "./frontend/index.d.ts",
      "import": "./frontend/index.js",
      "default": "./frontend/index.js"
    },
    "./frontend/*": {
      "types": "./frontend/*.d.ts",
      "import": "./frontend/*.js",
      "default": "./frontend/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "backend",
    "frontend",
    "NOTICE"
  ],
  "scripts": {
    "clean": "rm -rf backend frontend",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "tsc -p tsconfig.frontend.json && node -e \"require('fs').writeFileSync('frontend/package.json', JSON.stringify({type:'module'}))\"",
    "build": "npm run clean && npm run build:backend && npm run build:frontend",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "express": ">=4",
    "i18next": ">=23",
    "i18next-http-backend": ">=2",
    "jsonwebtoken": ">=9",
    "pg": ">=8",
    "react": ">=18",
    "react-i18next": ">=13"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "jsonwebtoken": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "i18next-http-backend": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "cookie-parser": "^1.4.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.2.46",
    "@types/supertest": "^7.2.0",
    "express": "^4.19.2",
    "i18next": "^23.11.0",
    "i18next-http-backend": "^2.7.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "react": "^18.2.0",
    "react-i18next": "^13.5.0",
    "supertest": "^7.2.2",
    "typescript": "7.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
